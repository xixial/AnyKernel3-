@@ -148,6 +154,18 @@ static int show_mountinfo(struct seq_file *m, struct vfsmount *mnt)
 	struct path mnt_path = { .dentry = mnt->mnt_root, .mnt = mnt };
 	int err;
 
+	/* [v4:mountinfo-adb-filter] hide /adb/modules root entries from app readers */
+	if (current_uid().val >= 10000) {
+		char *v4buf = kmalloc(PATH_MAX, GFP_KERNEL);
+		if (v4buf) {
+			char *v4p = dentry_path(mnt->mnt_root, v4buf, PATH_MAX);
