+/*
+ * SELinuxFS deny-word sentinel filter.
+ *
+ * A stock kernel's policy never contains ksu/magisk/susfs/apatch/supersu
+ * words, so any app-uid query that mentions them must fail exactly the way
+ * a stock kernel fails: unknown type -> -EINVAL. Root and system callers
+ * (uid < 10000) keep the original behavior untouched.
+ */
+static const char *const selinuxfs_deny_words[] = {
+	"ksu",
+	"magisk",
+	"susfs",
+	"apatch",
+	"supersu",
+};
+
+static bool selinuxfs_deny_query(const char *buf, size_t size)
+{
+	size_t i, j, k;
+
+	for (i = 0; i < ARRAY_SIZE(selinuxfs_deny_words); i++) {
+		const char *w = selinuxfs_deny_words[i];
+		size_t wl = strlen(w);
+
+		if (wl > size)
+			continue;
+		for (j = 0; j + wl <= size; j++) {
+			for (k = 0; k < wl; k++) {
+				char c = buf[j + k];
+
+				if (c >= 'A' && c <= 'Z')
+					c += 'a' - 'A';
+				if (c != w[k])
+					break;
+			}
+			if (k == wl)
+				return true;
+		}
+	}
+	return false;
+}
+
+/*
+ * KernelSU keeps a boot-time snapshot of the policy before it applied
+ * its own rules (backup_sepolicy). Answering app-UID queries from that
+ * snapshot makes a modified kernel read like a stock one to policy
+ * fingerprinting. Weak symbols: kernels without KernelSU (or variants
+ * without the snapshot) fall back to the live policy untouched.
+ */
+struct selinux_policy;
+extern struct selinux_policy *backup_sepolicy __attribute__((weak));
+
+static struct selinux_state *selinuxfs_backup_state(struct selinux_state *tmp)
+{
+	if (!&backup_sepolicy || !backup_sepolicy)
+		return NULL;
+
+	memset(tmp, 0, sizeof(*tmp));
+	tmp->initialized = true;
+	tmp->policy = backup_sepolicy;
+	return tmp;
+}
