+	if (__kuid_val(current_uid()) >= 10000 && selinuxfs_deny_query(buf, size)) {
+		length = -EINVAL;
+		goto out;
+	}
+
 	length = security_context_to_sid(state, buf, size, &sid, GFP_KERNEL);
 	if (length)
